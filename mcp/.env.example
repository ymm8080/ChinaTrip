# chinatrip — MCP / AI credentials template
# Copy to .env (or set as Windows user environment variables) and fill in the values.
# The MCP config (mcp.json / D:\chinatrip\.mcp.json) reads them via ${VAR} placeholders.

# 1) Amap (高德) Web-service key — POI / geocode / routing / direction testing
#    Create at: https://console.amap.com/dev/key/app  (type: Web服务)
AMAP_MAPS_API_KEY=

# 2) Qwen / DashScope API key — CN primary model, bilingual POI processing, 讲解 generation
#    Create at: https://bailian.console.aliyun.com/?apiKey=1
DASHSCOPE_API_KEY=

# 3) Sentry auth token — observability, project issue reads
#    Create at: https://sentry.io/settings/auth-tokens/ (scopes: project:read, event:read)
SENTRY_ACCESS_TOKEN=

# 4) Postgres connection used by postgres-mcp for schema inspection / PostGIS checks
#    Format: postgresql://user:password@host:5432/dbname
DATABASE_URI=

# 5) LiteLLM overseas fallback chain
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 6) GLM fallback — dedicated key for this project
#    Create at: https://open.bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=
