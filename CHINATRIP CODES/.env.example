# Copy to .env and fill in. Never commit .env (gitignored).

# PostgreSQL + PostGIS. docker-compose.yml brings this up as `db`.
DATABASE_URL=postgresql+psycopg://chinatrip:chinatrip@localhost:5432/chinatrip

# Zhipu GLM cloud API (personal key, OpenAI-compatible endpoint).
LLM_BACKEND=mock
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6
GLM_TIMEOUT_SECONDS=60

# Amap personal developer key. Server-side only - never reaches the client.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=5

# /extract guards (anonymous-phase cost gate)
EXTRACT_MAX_TEXT_CHARS=20000
EXTRACT_CONFIDENCE_THRESHOLD=0.8

# Anonymous rate limits (device_id + IP)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=600

# SMTP for email verification codes (register / forgot-password). All
# optional; empty SMTP_HOST = dev mode: no mail is sent, the code is
# echoed in a WARNING log + API response so registration works locally.
# Port 465 = implicit SSL, anything else (587) = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 客户付款层（DESIGN/PAYMENTS_PROGRESS.md）。mock = 零网络全流程（默认）；
# stripe = 填入 STRIPE_API_KEY 后启用 hosted Checkout（外卡+支付宝+微信支付）。
# STRIPE_WEBHOOK_SECRET 来自 Stripe CLI/dashboard webhook endpoint。
PAYMENTS_BACKEND=mock
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_DEFAULT_CURRENCY=cny
PAYMENTS_SUCCESS_URL=
PAYMENTS_CANCEL_URL=
# 运营侧代订扣款共享密钥（X-Operator-Token 头）；空 = 扣款端点禁用。
PAYMENTS_OPERATOR_TOKEN=
PAYMENTS_DB_URL=sqlite:///data/payments.db

LOG_LEVEL=INFO
