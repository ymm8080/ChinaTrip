# INTL deployment profile (DESIGN language_dual_system v1.0 §7).
# Copy to .env on the overseas server. One codebase, region-split config.
# CN station uses the default .env; never mix profiles on one host.

# Region switch — stamped on usage logs; gates intl behaviors (§7 matrix).
REGION=INTL

# PostgreSQL + PostGIS on the overseas host (user data stays in-region).
DATABASE_URL=postgresql+psycopg://chinatrip:chinatrip@localhost:5432/chinatrip

# LLM: Zhipu international endpoint (or an in-region provider once wired).
LLM_BACKEND=zhipu
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_TIMEOUT_SECONDS=60

# Amap is CN-only reachable: point base URL at the CN-side proxy tunnel
# (config.py reserves this path; raise timeout for cross-border latency).
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=5
AMAP_ROUTE_TIMEOUT_SECONDS=10

# Trains: 12306 reachable from overseas in tests; if blocked, route via
# the same CN proxy or set TRAIN_REMOTE_ENABLED=false (mock fallback).
TRAIN_REMOTE_ENABLED=true

# Reference sync consumer (jobs/import_reference). Reference NDJSON is
# produced CN-side and shipped via object storage; import is read-only
# against user data. Schedule daily after the CN export (see ops docs).
# No extra keys needed — file-based handoff.

# SMTP: use an in-region mail provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- 一键切图商（2026-10-27 接入百度 / 2026-10-28 全量收口）----
# amap | baidu：API 平面/规划器/天气抓取/chinatravel 导入/deeplinks/前端步行外链
# 全部跟随此开关；仅 refresh_pois、enrich_amap_detail、poi_backfill 仍绑高德
# （POI 库 source/amap_id 列语义，见 app/services/map_provider.py 模块注释）。
MAP_PROVIDER=amap
BAIDU_AK=
BAIDU_BASE_URL=https://api.map.baidu.com
